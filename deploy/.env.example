# Production environment for deploy/docker-compose.yml (S-12).
# Copy to deploy/.env and fill in real values. Never commit this file.

# Caddy needs a real domain for automatic HTTPS.
DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Postgres
POSTGRES_USER=quran
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=quran

# The rest lives in server/.env (see server/.env.example): DATABASE_URL is
# built by compose from the values above, and the S3_* values must point at
# Cloudflare R2 (D4).
