# Server environment (02 §2). Copy to .env and fill in real values.
# `.env` is never committed; see .gitignore.

DATABASE_URL=postgres://quran:quran@localhost:5432/quran
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
CDN_BASE_URL=http://localhost:8787/cdn

# Cloudflare R2 (D4). Endpoint is https://<account-id>.r2.cloudflarestorage.com
# and the region is always "auto". Use the dev bucket while developing.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=quran-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# base64 of a 32-byte Ed25519 seed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MANIFEST_SIGNING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MANIFEST_KEY_ID=k1
MANIFEST_TTL_DAYS=7

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ADMIN_ORIGIN=http://localhost:8787

LOG_LEVEL=info

ONESIGNAL_APP_ID_STABLE=00000000-0000-0000-0000-000000000000
ONESIGNAL_APP_ID_BETA=00000000-0000-0000-0000-000000000001
ONESIGNAL_REST_API_KEY_STABLE=test-stable-key
ONESIGNAL_REST_API_KEY_BETA=test-beta-key
